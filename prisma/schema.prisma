generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  MANAGER
  EMPLOYEE
}

enum ExpenseType {
  FOOD
  OTHER
  TRIP
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum OtherLeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum TripStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

model User {
  id                    String                    @id @default(cuid())
  email                 String                    @unique
  name                  String
  passwordHash          String
  role                  Role
  isActive              Boolean                   @default(true)
  mustChangePassword    Boolean                   @default(false)
  birthday              DateTime?
  managerId             String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  manager               User?                     @relation("UserManager", fields: [managerId], references: [id])
  teamMembers           User[]                    @relation("UserManager")
  refreshTokens         RefreshToken[]
  leaveBalances         LeaveBalance[]
  leaveRequests         LeaveRequest[]            @relation("LeaveRequestUser")
  reviewedLeaveRequests LeaveRequest[]            @relation("LeaveRequestReviewer")
  otherLeaveRequests    OtherLeaveRequest[]       @relation("OtherLeaveUser")
  reviewedOtherLeaves   OtherLeaveRequest[]       @relation("OtherLeaveReviewer")
  expenses              Expense[]                 @relation("ExpenseUser")
  settledExpenses       Expense[]                 @relation("ExpenseSettledBy")
  archivedExpenses      Expense[]                 @relation("ExpenseArchivedBy")
  trips                 Trip[]                    @relation("TripUser")
  reviewedTrips         Trip[]                    @relation("TripReviewer")
  budgets               MonthlyBudget[]
  fundAdjustments       EmployeeFundAdjustment[]  @relation("FundAdjustmentActor")
  employeeAdjustments   EmployeeFundAdjustment[]  @relation("FundAdjustmentEmployee")
  fundContributions     EmployeeFundContribution[]
  invitesSent           UserInvite[]              @relation("InviteSender")
  settlements           ExpenseSettlement[]       @relation("SettlementEmployee")
  processedSettlements  ExpenseSettlement[]       @relation("SettlementActor")
  auditLogs             AuditLog[]                @relation("AuditActor")
  pushSubscriptions     PushSubscription[]

  @@index([managerId])
  @@index([role, isActive])
}

model RefreshToken {
  id          String   @id @default(cuid())
  userId      String
  tokenHash   String   @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime @default(now())
  rotatedFrom String?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model LeaveType {
  id           String         @id @default(cuid())
  code         String         @unique
  name         String
  annualDays   Int
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  leaveBalance LeaveBalance[]
  requests     LeaveRequest[]
}

model LeaveBalance {
  id          String    @id @default(cuid())
  userId      String
  leaveTypeId String
  year        Int
  baseDays    Int
  extraDays   Int       @default(0)
  usedDays    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([userId, leaveTypeId, year])
  @@index([userId, year])
}

model LeaveRequest {
  id           String             @id @default(cuid())
  userId       String
  leaveTypeId  String
  startDate    DateTime
  endDate      DateTime
  totalDays    Int
  reason       String
  status       LeaveRequestStatus @default(PENDING)
  reviewNote   String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  user         User               @relation("LeaveRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  leaveType    LeaveType          @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  reviewedBy   User?              @relation("LeaveRequestReviewer", fields: [reviewedById], references: [id])

  @@index([userId, status, startDate])
}

model OtherLeaveRequest {
  id           String           @id @default(cuid())
  userId       String
  title        String
  reason       String
  startDate    DateTime
  endDate      DateTime
  totalDays    Int
  status       OtherLeaveStatus @default(PENDING)
  reviewNote   String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  user         User             @relation("OtherLeaveUser", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy   User?            @relation("OtherLeaveReviewer", fields: [reviewedById], references: [id])

  @@index([userId, status, startDate])
}

model Trip {
  id              String       @id @default(cuid())
  userId          String
  title           String
  destination     String
  purpose         String
  departureDate   DateTime
  returnDate      DateTime
  totalDays       Int
  estimatedBudget Decimal      @db.Decimal(12, 2)
  actualTotal     Decimal      @default(0) @db.Decimal(12, 2)
  status          TripStatus   @default(PENDING)
  reviewNote      String?
  reviewedById    String?
  reviewedAt      DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  user            User         @relation("TripUser", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy      User?        @relation("TripReviewer", fields: [reviewedById], references: [id])
  itinerary       TripItinerary[]
  expenses        Expense[]

  @@index([userId, status, departureDate])
}

model TripItinerary {
  id         String   @id @default(cuid())
  tripId      String
  dayNumber   Int
  date        DateTime
  activities  String
  notes       String?
  createdAt   DateTime @default(now())
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, dayNumber])
}

model Expense {
  id             String       @id @default(cuid())
  userId          String
  tripId          String?
  expenseType     ExpenseType
  title           String
  description     String?
  amount          Decimal      @db.Decimal(12, 2)
  expenseDate     DateTime
  month           Int
  year            Int
  isSettled       Boolean      @default(false)
  settledAt       DateTime?
  settledById     String?
  archivedAt      DateTime?
  archivedById    String?
  archivedReason  String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  user            User         @relation("ExpenseUser", fields: [userId], references: [id], onDelete: Cascade)
  trip            Trip?        @relation(fields: [tripId], references: [id], onDelete: SetNull)
  settledBy       User?        @relation("ExpenseSettledBy", fields: [settledById], references: [id])
  archivedBy      User?        @relation("ExpenseArchivedBy", fields: [archivedById], references: [id])

  @@index([userId, year, month])
  @@index([expenseType, expenseDate])
  @@index([isSettled, archivedAt])
}

model ExpenseSettlement {
  id            String   @id @default(cuid())
  employeeId    String
  month         Int
  year          Int
  totalAmount   Decimal  @db.Decimal(12, 2)
  isSettled     Boolean  @default(true)
  history       Json
  settledById   String
  settledAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  employee      User     @relation("SettlementEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  settledBy     User     @relation("SettlementActor", fields: [settledById], references: [id])

  @@unique([employeeId, month, year])
  @@index([month, year])
}

model MonthlyBudget {
  id            String   @id @default(cuid())
  amount        Decimal  @db.Decimal(12, 2)
  effectiveFrom DateTime
  note          String?
  createdById   String
  createdAt     DateTime @default(now())
  createdBy     User     @relation(fields: [createdById], references: [id])

  @@index([effectiveFrom(sort: Desc)])
}

model EmployeeFund {
  id                 String   @id
  contributionAmount Decimal  @default(1200) @db.Decimal(12, 2)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  contributions      EmployeeFundContribution[]
  adjustments        EmployeeFundAdjustment[]
}

model EmployeeFundContribution {
  id               String   @id @default(cuid())
  fundId           String
  userId           String
  year             Int
  amount           Decimal  @db.Decimal(12, 2)
  contributionDate DateTime
  createdAt        DateTime @default(now())
  fund             EmployeeFund @relation(fields: [fundId], references: [id], onDelete: Cascade)
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year])
  @@index([contributionDate])
}

model EmployeeFundAdjustment {
  id           String   @id @default(cuid())
  fundId        String
  employeeId    String
  amount        Decimal  @db.Decimal(12, 2)
  reason        String
  adjustedById  String
  createdAt     DateTime @default(now())
  fund          EmployeeFund @relation(fields: [fundId], references: [id], onDelete: Cascade)
  employee      User         @relation("FundAdjustmentEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  adjustedBy    User         @relation("FundAdjustmentActor", fields: [adjustedById], references: [id])

  @@index([employeeId, createdAt])
}

model UserInvite {
  id           String   @id @default(cuid())
  email        String
  name         String?
  role         Role
  managerId    String?
  tokenHash    String   @unique
  expiresAt    DateTime
  acceptedAt   DateTime?
  revokedAt    DateTime?
  invitedById  String
  createdAt    DateTime @default(now())
  invitedBy    User     @relation("InviteSender", fields: [invitedById], references: [id])

  @@index([email, expiresAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId     String?
  action      String
  entityType  String
  entityId    String?
  targetUserId String?
  metadata    Json?
  createdAt   DateTime @default(now())
  actor       User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([action, createdAt])
  @@index([targetUserId, createdAt])
}
